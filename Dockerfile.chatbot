FROM python:3.11-slim

WORKDIR /app

# Base deps only — the eval/redteam extras (ragas, deepeval, pyrit, garak,
# fairlearn) pull in torch/transformers/CUDA wheels that this serving image
# has no runtime need for. Those live in Dockerfile.eval instead.
COPY pyproject.toml .
RUN pip install --no-cache-dir -e "."

# Copy application code
COPY src/chatbot/ src/chatbot/
COPY src/__init__.py src/

EXPOSE 8000

CMD ["uvicorn", "src.chatbot.main:app", "--host", "0.0.0.0", "--port", "8000"]
